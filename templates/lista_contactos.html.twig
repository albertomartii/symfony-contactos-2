{% extends 'base.html.twig' %}

{% block title %}Lista de Contactos{% endblock %}

{% block body %}
<div class="container">
    <h1>Lista de Contactos{% if letra is defined and letra %} que empiezan por "{{ letra }}"{% endif %}</h1>

    <div class="acciones" style="margin-bottom: 20px; display: flex; gap: 15px;">
        <a href="{{ path('nuevo_contacto') }}" class="btn btn-success">Crear nuevo contacto</a>
        <a href="{{ path('inicio') }}" class="btn btn-secondary">Volver a Inicio</a>
    </div>

    {% if contactos is empty %}
    <p>No hay contactos guardados.</p>
    {% else %}
    <div class="lista-contactos">
        {% for contacto in contactos %}
        <div class="contacto-card"
            style="border: 1px solid #ccc; padding: 15px; margin-bottom: 10px; background-color: #ffffff; border-radius: 5px;">
            {{ include('partials/_contacto.html.twig', {'contacto': contacto}) }}
            <div style="margin-top: 10px;">
                <a href="{{ path('contacto', {'codigo': contacto.id}) }}" class="btn btn-sm">Ver ficha</a>
                <a href="{{ path('borrar', {'codigo': contacto.id}) }}" class="btn btn-sm btn-danger"
                    onclick="return confirm('¿Seguro que deseas borrar este contacto?');">Borrar</a>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}